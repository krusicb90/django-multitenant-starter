# Copy to ${APP_DIR}/.env on the server (chmod 600) and fill in. Never commit the real file.

# --- Image ---
IMAGE=ghcr.io/your-org/your-app
IMAGE_TAG=latest
# Optional: credentials for docker login when the registry is private
REGISTRY=ghcr.io
REGISTRY_USER=
REGISTRY_TOKEN=

# --- Site ---
DOMAIN=app.example.com
SITE_URL=https://app.example.com
SITE_NAME=Starter
SECRET_KEY=
DEBUG=False
# "localhost" is needed by the container health check
ALLOWED_HOSTS=app.example.com,localhost
CSRF_TRUSTED_ORIGINS=https://app.example.com
USE_HTTPS=True
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60
REDIS_URL=redis://redis:6379/0

# --- PostgreSQL ---
# The user needs CREATEDB: every tenant gets its own database.
DB_HOST=
DB_PORT=5432
DB_NAME=app_main
DB_USER=
DB_PASSWORD=
DB_SSLMODE=require
# Database to connect to for CREATE/DROP DATABASE ("postgres" on a self-hosted server)
DB_MAINTENANCE_NAME=postgres
TENANT_DB_PREFIX=tenant_
# Client tools image for backups; keep the major version equal to the server's
PG_IMAGE=postgres:16-alpine

# --- Platform superadmin (created on first start) ---
SUPERUSER_USERNAME=
SUPERUSER_EMAIL=
SUPERUSER_PASSWORD=

# --- Trials and licences ---
TRIAL_PERIOD_DAYS=30
LICENCE_GRACE_DAYS=7

# --- Email: SMTP ... ---
EMAIL_ENABLED=True
DEFAULT_FROM_EMAIL=noreply@example.com
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# --- ... or the Mailgun HTTP API ---
# EMAIL_BACKEND=config.mailgun_backend.MailgunBackend
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=
# MAILGUN_BASE_URL=https://api.eu.mailgun.net

# --- Cloudflare Turnstile (optional) ---
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_BYPASS_IPS=

# --- Backups ---
BACKUP_RETENTION_DAYS=14
BACKUP_WEEKLY_KEEP=8
# rclone remote for the off-site copy, e.g. offsite:my-bucket/backups (empty = local only)
BACKUP_RCLONE_REMOTE=
# URL to ping after a successful daily backup (dead man's switch monitoring)
BACKUP_PING_URL=
